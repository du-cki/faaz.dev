---
import Layout from "@/layouts/Layout.astro";

import dayjs from "dayjs";
import { getArticle } from "@/utils/";

import Socials from "@/components/home/Socials.astro";

import LeftSide from "@/components/home/LeftSide.astro";
import RightSide from "@/components/home/RightSide.astro";

import { DATE_OF_BIRTH } from "@/utils/constants";
import Popover from "@/components/common/Popover";

const year_of_birth = dayjs().diff(DATE_OF_BIRTH, "years");
const name = {
  romanization: "Faaz",
  native: "فاز",
  ipa: "fa:z",
};
---

<Layout title="Home">
  <section>
    <h1 class="text-5xl!">
      Hello! I'm{" "}
      <Popover align="center" client:idle>
        {name.romanization}
        <span slot="content" class="flex divide-x divide-neutral-200">
          <span lang="ar" class="pr-3 text-2xl">{name.native}</span>
          <span
            class="flex items-center pl-3 text-sm tracking-wide text-neutral-500"
          >
            /{name.ipa}/
          </span>
        </span>
      </Popover>.
    </h1>

    <p class="mb-6">
      I am {getArticle(year_of_birth)}
      {" "}
      {year_of_birth}
      {" "}
      year old full-stack developer from the United Arab Emirates who loves programming
      both professionally and as a hobby.
    </p>

    <Socials />
  </section>

  <section>
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-16">
        <LeftSide />
      </div>

      <div class="space-y-8">
        <RightSide />
      </div>
    </div>
  </section>
</Layout>
