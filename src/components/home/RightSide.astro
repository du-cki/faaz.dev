---
import { Friends } from "@/utils/constants";

import { Icon } from "astro-icon/components";

import About from "./About";
import CodingStats from "./CodingStats";

import Link from "../common/Link.astro";
import ExploreLink from "../common/ExploreLink.astro";

const Explore: {
  href: string;
  label: string;
  description: string;
  icon: string;
}[] = [
  {
    href: "/me/music",
    label: "Music",
    description: "Top Songs & Artists",
    icon: "lucide:music",
  },
];
---

<section>
  <About client:load />
</section>

<section>
  <CodingStats client:idle />
</section>

<section>
  <h2 class="text-2xl font-medium mb-4">Friends</h2>

  <div class="space-y-2">
    {
      Friends.map(({ name, githubUsername, href }) => (
        <Link
          text={name}
          description={`@${githubUsername}`}
          href={`${href}?utm_source=faaz.dev`}
        >
          <img
            src={`https://github.com/${githubUsername}.png`}
            alt={`${name}'s profile picture'`}
            class="w-10 h-10 rounded-lg shadow-lg"
            height={40}
            width={40}
            slot="icon"
          />
        </Link>
      ))
    }
  </div>
</section>

<section>
  <h2 class="text-2xl font-medium mb-4">Explore</h2>

  <div class="space-y-2">
    {
      Explore.map((page) => (
        <ExploreLink
          text={page.label}
          href={page.href}
          description={page.description}
        >
          <Icon
            name={page.icon}
            class="w-5 h-5 text-gray-600 group-hover:text-gray-800"
            slot="icon"
          />
        </ExploreLink>
      ))
    }
  </div>
</section>
