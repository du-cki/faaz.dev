---
import { Icon } from "astro-icon/components";

interface Props {
  text: string;
  href: string;
  description?: string;
}

const { text, href, description } = Astro.props;
---

<a
  href={href}
  class="group flex items-center justify-between transition-colors py-2.5"
>
  <div class="flex items-center gap-3">
    <slot name="icon" />

    <div class="flex items-baseline gap-2.5">
      <span class="font-medium text-gray-900">{text}</span>

      {description && <span class="text-sm text-gray-500">{description}</span>}
    </div>
  </div>

  <Icon
    name="lucide:arrow-up-right"
    class="w-4 h-4 text-gray-400 group-hover:text-accent group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform"
  />
</a>
