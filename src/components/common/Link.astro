---
type Props = {
  text: string;
  href: string;
  description?: string;
};

const { text, href, description } = Astro.props;
const target = href.startsWith("/") ? "_self" : "_blank";
---

<a
  href={href}
  target={target}
  class="flex items-center gap-3 p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors group shadow-md"
>
  <slot name="icon" />

  <div>
    <span class="text-xs font-semibold text-gray-900 flex items-center gap-1">
      {text}
    </span>

    <span class="text-xs text-gray-600">{description}</span>
  </div>
</a>
