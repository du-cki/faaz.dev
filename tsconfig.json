{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/utils*": [
        "./utils/*"
      ],
      "@/lib*": [
        "./lib/*"
      ],
      "@/components*": [
        "./src/components/*"
      ],
      "@/layouts*": [
        "./src/layouts/*"
      ]
    }
  }
}